@model LoginVm
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<style>
    /* Evita que Edge dibuje su propio botón de revelar junto al botón accesible de la vista. */
    .login-shell input[type="password"]::-ms-reveal,
    .login-shell input[type="password"]::-ms-clear { display: none; }
</style>

<section class="login-shell">
    <aside class="login-aside">
        <h2>Gestión de Conciliación SBSS</h2>
        <p>Registro y seguimiento de expedientes, audiencias y documentos del Centro de Conciliación Extrajudicial.</p>
        <p class="nota">Sistema de uso interno, conforme a la Ley N.° 26872 y su Reglamento, D.S. N.° 004-2005-JUS.</p>
    </aside>

    <div class="login-main">
        <div class="panel">
            <div style="margin-bottom:24px;">
                <h1 style="font-size:1.4rem;">Acceso al sistema</h1>
                <p style="color:var(--muted);font-size:0.9rem;margin:6px 0 0;">Ingresa con tu usuario y contraseña.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="form-sbss">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <label asp-for="Usuario">Usuario o correo</label>
                <input asp-for="Usuario" class="form-control" autofocus />
                <span asp-validation-for="Usuario" class="text-danger"></span>

                <label asp-for="Contrasenia">Contraseña</label>
                <div style="position:relative;">
                    <input asp-for="Contrasenia" type="password" autocomplete="current-password" class="form-control" style="padding-right:3.25rem;" />
                    <button type="button" id="togglePassword" aria-label="Mostrar contraseña" aria-controls="Contrasenia" aria-pressed="false"
                            style="position:absolute;top:0;bottom:0;right:0.35rem;width:2.5rem;border:0;background:transparent;color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;">
                        <svg data-eye-show viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="display:block;position:absolute;">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg data-eye-hide viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" style="display:none;position:absolute;">
                            <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a15.8 15.8 0 0 1-3.1 3.9M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7c1.2 0 2.3-.3 3.3-.7" />
                        </svg>
                    </button>
                </div>
                <span asp-validation-for="Contrasenia" class="text-danger"></span>

                <button type="submit" class="btn btn-primary" style="width:100%;margin-top:6px;">Ingresar</button>
            </form>

            <p style="text-align:center;margin:20px 0 0;font-size:0.85rem;">
                <a asp-controller="Account" asp-action="OlvideContrasenia" style="color:var(--celeste-ink);text-decoration:underline;">¿Olvidaste tu contraseña?</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const passwordInput = document.getElementById("Contrasenia");
            const passwordToggle = document.getElementById("togglePassword");

            passwordToggle?.addEventListener("click", () => {
                const showPassword = passwordInput.type === "password";
                passwordInput.type = showPassword ? "text" : "password";
                passwordToggle.setAttribute("aria-label", showPassword ? "Ocultar contraseña" : "Mostrar contraseña");
                passwordToggle.setAttribute("aria-pressed", String(showPassword));
                passwordToggle.querySelector("[data-eye-show]").style.display = showPassword ? "none" : "block";
                passwordToggle.querySelector("[data-eye-hide]").style.display = showPassword ? "block" : "none";
            });
        })();
    </script>
}

