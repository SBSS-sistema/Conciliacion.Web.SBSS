@model LoginVm
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<section class="login-shell">
    <aside class="login-aside">
        <h2>Gestión de Conciliación SBSS</h2>
        <p>Registro y seguimiento de expedientes, audiencias y documentos del Centro de Conciliación Extrajudicial.</p>
        <p class="nota">Sistema de uso interno, conforme a la Ley N.° 26872 y su Reglamento, D.S. N.° 004-2005-JUS.</p>
    </aside>

    <div class="login-main">
        <div class="panel">
            <div style="margin-bottom:24px;">
                <h1 style="font-size:1.4rem;">Acceso al sistema</h1>
                <p style="color:var(--muted);font-size:0.9rem;margin:6px 0 0;">Ingresa con tu usuario y contraseña.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post" class="form-sbss">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <label asp-for="Usuario">Usuario o correo</label>
                <input asp-for="Usuario" class="form-control" autofocus />
                <span asp-validation-for="Usuario" class="text-danger"></span>

                <label asp-for="Contrasenia">Contraseña</label>
                <input asp-for="Contrasenia" class="form-control" />
                <span asp-validation-for="Contrasenia" class="text-danger"></span>

                <button type="submit" class="btn btn-primary" style="width:100%;margin-top:6px;">Ingresar</button>
            </form>

            <p style="text-align:center;margin:20px 0 0;font-size:0.85rem;">
                <a asp-controller="Account" asp-action="OlvideContrasenia" style="color:var(--celeste-ink);text-decoration:underline;">¿Olvidaste tu contraseña?</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
