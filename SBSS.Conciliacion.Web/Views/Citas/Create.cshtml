@model CrearCitaVm
@{
    ViewData["Title"] = "Agendar cita";
    var conciliadores = ViewBag.Conciliadores as List<Trabajador> ?? new();
    var sedes = ViewBag.Sedes as List<Sede> ?? new();
    var personas = ViewBag.Personas as List<PersonaListItem> ?? new();
    var materias = ViewBag.Materias as List<Materia> ?? new();
}
<div class="wrap page-head"><h1>Agendar cita</h1><p>Selecciona una persona registrada, la materia y el conciliador para programar su primera atención.</p></div>
<div class="wrap"><div class="panel" style="max-width:760px;">
<form asp-action="Create" method="post" class="form-sbss">
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

    <label asp-for="IdPersona">Persona solicitante</label>
    <select asp-for="IdPersona" class="form-control" id="IdPersona">
        <option value="">-- Buscar y seleccionar persona --</option>
        @foreach (var p in personas)
        {
            <option value="@p.IdPersona"
                    data-nombre="@p.NombreCompleto"
                    data-documento="@p.Documento"
                    data-tipo="@(p.TipoPersona == "NATURAL" ? "Persona natural" : "Persona jurídica")"
                    data-contacto="@(p.CelularP ?? p.CorreoP ?? "Sin contacto registrado")">
                @p.NombreCompleto · @(p.TipoPersona == "NATURAL" ? "Natural" : "Jurídica") · @p.Documento
            </option>
        }
    </select>
    <span asp-validation-for="IdPersona" class="text-danger"></span>
    <div id="personaSeleccionada" class="panel" style="padding:12px 16px;margin:0 0 16px;display:none;">
        <strong id="personaNombre"></strong>
        <span id="personaTipo" style="margin-left:8px;color:#4a5a61;"></span><br />
        <span id="personaDocumento"></span> · <span id="personaContacto"></span>
    </div>
    @if (personas.Count == 0)
    {
        <p class="text-danger">No hay personas activas registradas. Registra primero a la persona en el módulo Personas.</p>
    }

    <label asp-for="IdMateria">Materia de consulta</label>
    <select asp-for="IdMateria" class="form-control">
        <option value="">-- Selecciona una materia --</option>
        @foreach (var materia in materias)
        {
            <option value="@materia.IdMateria">@materia.NombreMateria</option>
        }
    </select>
    <span asp-validation-for="IdMateria" class="text-danger"></span>

    <label asp-for="Motivo">Motivo o detalle de consulta</label>
    <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Motivo" class="text-danger"></span>

    <label asp-for="IdSede">Sede de atención</label>
    <select asp-for="IdSede" class="form-control" id="IdSede">
        <option value="">-- Selecciona sede --</option>
        @foreach (var sede in sedes)
        {
            <option value="@sede.IdSede">@sede.Nombre</option>
        }
    </select>
    <span asp-validation-for="IdSede" class="text-danger"></span>

    <label asp-for="IdConciliador">Conciliador asignado</label>
    <select asp-for="IdConciliador" class="form-control" id="IdConciliador">
        <option value="">-- Selecciona conciliador --</option>
        @foreach (var t in conciliadores)
        {
            <option value="@t.IdTrabajador" data-sede="@t.IdSedeRef">@t.NombreCompleto</option>
        }
    </select>
    <span asp-validation-for="IdConciliador" class="text-danger"></span>
    @if (sedes.Count == 0)
    {
        <p class="text-danger">No hay sedes activas disponibles.</p>
    }

    <label asp-for="FechaHora">Fecha y hora</label>
    <input asp-for="FechaHora" type="datetime-local" class="form-control" value="@Model.FechaHora.ToString("yyyy-MM-ddTHH:mm")" />
    <span asp-validation-for="FechaHora" class="text-danger"></span>

    <label asp-for="Observaciones">Observaciones (opcional)</label>
    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>

    <div style="display:flex;gap:12px;">
        <button type="submit" class="btn btn-primary" disabled="@(personas.Count == 0 || materias.Count == 0 || sedes.Count == 0)">Guardar cita</button>
        <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
    </div>
</form></div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const select = document.getElementById("IdPersona");
            const panel = document.getElementById("personaSeleccionada");
            const sedeSelect = document.getElementById("IdSede");
            const conciliadorSelect = document.getElementById("IdConciliador");
            const filtrarConciliadores = () => {
                const idSede = sedeSelect.value;
                for (const option of conciliadorSelect.options) {
                    if (!option.value) continue;
                    const coincide = idSede && option.dataset.sede === idSede;
                    option.hidden = !coincide;
                    option.disabled = !coincide;
                }
                const actual = conciliadorSelect.options[conciliadorSelect.selectedIndex];
                if (actual && actual.value && (actual.hidden || actual.disabled)) conciliadorSelect.value = "";
            };
            sedeSelect.addEventListener("change", filtrarConciliadores);
            filtrarConciliadores();
            const update = () => {
                const option = select.options[select.selectedIndex];
                const selected = option && option.value;
                panel.style.display = selected ? "block" : "none";
                if (!selected) return;
                document.getElementById("personaNombre").textContent = option.dataset.nombre || "";
                document.getElementById("personaTipo").textContent = option.dataset.tipo || "";
                document.getElementById("personaDocumento").textContent = "Documento: " + (option.dataset.documento || "—");
                document.getElementById("personaContacto").textContent = option.dataset.contacto || "";
            };
            select.addEventListener("change", update);
            update();
        })();
    </script>
}
